# ── Hosted LLM: AI Model Router (primary) ────────────────────────────────────
# When AI_MODEL_ROUTER_API_KEY is set, every hosted call (copilot chat, multi-agent
# pipeline, strategy parsing, thesis extraction, intent routing) goes through the
# router. Model ids are the router catalog ids shown in the UI selector.
AI_MODEL_ROUTER_BASE_URL=https://ai-model-router-api.eu.foundations.prod.int.hellofresh.io
AI_MODEL_ROUTER_API_KEY=your_ai_model_router_api_key
AI_MODEL_ROUTER_MODEL=Fast
AI_MODEL_ROUTER_MAX_TOKENS=8192

# ── AWS Bedrock (legacy fallback) ────────────────────────────────────────────
# Used automatically when AI_MODEL_ROUTER_API_KEY is empty, and when a request
# explicitly selects provider="bedrock".
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
DATABASE_URL=sqlite+aiosqlite:///./quant.db
# Free data APIs for multi-agent pipeline
FINNHUB_API_KEY=          # free at finnhub.io
FRED_API_KEY=             # free at fred.stlouisfed.org
# Optional — enables LangFuse tracing for all LLM calls (Bedrock/router + Ollama)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com  # override for self-hosted
# Ollama local (optional overrides)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:9b
# OLLAMA_TIMEOUT=300
# Ollama Cloud — get key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=your_ollama_api_key
# OLLAMA_CLOUD_MODEL=gpt-oss:120b
# Deep-research agent (Perplexity, OpenAI-compatible). Default = self-hosted
# perplexity-scrape proxy (github.com/mrdzer0/perplexity-scrape): run it, then set
# PERPLEXITY_SESSION_TOKEN from your Pro browser cookies in the proxy's own env.
# Set DISABLE_PERPLEXITY=true to skip the scraper container + health check at
# startup and hide the Perplexity research UI (use the embedded ChatGPT pane
# instead). Flip to false to re-enable everything exactly as before.
# DISABLE_PERPLEXITY=false
# PERPLEXITY_BASE_URL=http://127.0.0.1:8045/v1
# PERPLEXITY_MODEL=claude45sonnetthinking
# PERPLEXITY_API_KEY=          # leave empty for scrape proxy
# To switch to the official Sonar API (stable, real citation URLs, ~cents/day):
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar-pro
# Optional: cheaper model for intent routing on the Bedrock fallback
# (on the router it resolves to AI_MODEL_ROUTER_MODEL)
# BEDROCK_ROUTER_MODEL_ID=eu.anthropic.claude-haiku-4-5
